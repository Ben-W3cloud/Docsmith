# ---------------------------------------------------------------------------
# LLM / OpenAI-compatible endpoint
# ---------------------------------------------------------------------------
# Base URL for the OpenAI-compatible API.
# Examples:
#   https://api.openai.com/v1
#   https://integrate.api.nvidia.com/v1
BASE_URL="https://integrate.api.nvidia.com/v1"

# API key / bearer token for the LLM endpoint.
API_KEY="your-api-key-here"

# Model identifier to use for completions.
# Examples: gpt-4o, deepseek-ai/deepseek-v4-pro, etc.
MODEL="deepseek-ai/deepseek-v4-pro"

# ---------------------------------------------------------------------------
# GitHub API (optional but recommended — raises rate limit to 5,000/hr)
# ---------------------------------------------------------------------------
# Create a fine-grained PAT with no permissions needed for public repo reads.
# Or use a classic PAT with the `public_repo` scope.
GITHUB_TOKEN="ghp_your-github-token-here"